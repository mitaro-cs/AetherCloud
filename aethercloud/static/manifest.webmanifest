{
  "name": "AetherCloud",
  "short_name": "AetherCloud",
  "description": "Self-hosted cloud storage that runs from your own disk.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#070b15",
  "theme_color": "#090d18",
